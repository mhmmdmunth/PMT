{
  "entities": {
    "ProjectData": {
      "title": "ProjectData",
      "description": "Complete shipyard project document stored in Firestore so AI Studio and deployed web domains (e.g. Vercel) stay 100% identical.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vessel": { "type": "object" },
        "schedule": { "type": "object" },
        "categories": { "type": "array" },
        "workItems": { "type": "array" },
        "opnameItems": { "type": "array" },
        "defectSurveys": { "type": "array" },
        "signatures": { "type": "object" },
        "status": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastModified": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastClientId": { "type": "string", "maxLength": 128 },
        "isDeleted": { "type": "boolean" },
        "extras": { "type": "object" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectData" },
      "description": "Project document storing complete collaborative shipyard repair, opname, survey, material, resource, satisfaction note, and RAB data."
    }
  }
}
